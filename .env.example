# OKauto environment template
# Copy to apps/web/.env.local and apps/worker/.env

NODE_ENV=development
DATABASE_URL=postgresql://okauto:okauto@localhost:5432/okauto
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:3000
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Optional AI (OpenAI-compatible). Leave empty to use template engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email (optional — logs to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@okauto.local

# Observability
LOG_LEVEL=info
