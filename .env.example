# Generate long random values; never reuse defaults in production.
DATABASE_URL=postgres://driveflow:driveflow@localhost:5432/driveflow
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
SESSION_PEPPER=replace-with-at-least-32-random-characters
IP_HASH_KEY=replace-with-at-least-32-random-characters

# Optional OpenAI-compatible provider. Without these, the grounded local
# description engine remains available.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Comma-separated origins allowed to call extension preparation endpoints.
EXTENSION_ORIGINS=chrome-extension://replace-after-local-install
LOG_LEVEL=info
