# OKauto environment template
# Copy to .env and adjust values. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Postgres
POSTGRES_USER=okauto
POSTGRES_PASSWORD=okauto
POSTGRES_DB=okauto
DATABASE_URL=postgresql://okauto:okauto@localhost:5432/okauto?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,chrome-extension://

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# AI (optional — falls back to deterministic templates)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Media
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Worker
SYNC_CRON="*/15 * * * *"
ALERT_POLL_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
