# ------------------------------------------------------------------
# OKauto environment template. Copy to .env and fill in values.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://okauto:okauto@localhost:5432/okauto?schema=public"

# --- Auth ---
# 32+ char random string. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
# Session lifetime (seconds). Default 7 days.
AUTH_SESSION_TTL="604800"

# --- Web app ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated origins allowed to call the API from the extension.
API_ALLOWED_ORIGINS="chrome-extension://*,http://localhost:3000"

# --- AI provider (optional) ---
# If unset, OKauto uses the built-in deterministic template generator.
# Supported: openai
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Media storage (optional) ---
# Supported: local | s3
MEDIA_STORAGE="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Background worker ---
# Poll interval for the DB-backed job queue, in ms.
WORKER_POLL_INTERVAL_MS="2000"

# --- Observability (optional) ---
LOG_LEVEL="info"
