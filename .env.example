# ─── OKauto environment template ─────────────────────────────────────────────
# Copy to .env for local development. Never commit real secrets.

# Database
DATABASE_URL="postgresql://okauto:okauto_dev_password@localhost:5432/okauto"

# API service
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL="http://localhost:4000"
# Comma-separated list of allowed CORS origins (dashboard, extension id)
CORS_ORIGINS="http://localhost:3000"

# Auth secrets (generate: openssl rand -hex 32)
JWT_SECRET="dev-only-insecure-secret-change-me"
REFRESH_COOKIE_NAME="okauto_rt"

# Web dashboard
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# VIN decoding provider: local (default, offline) | vpic (public NHTSA API)
VIN_PROVIDER=local

# Description AI provider: template (default, offline) | openai-compatible
DESCRIPTION_PROVIDER=template
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Notifications email transport: log (default) | smtp
EMAIL_TRANSPORT=log
SMTP_URL=""

# Import/sync
IMPORT_HTTP_TIMEOUT_MS=15000
IMPORT_MAX_PHOTOS=40
SYNC_SWEEP_INTERVAL_MS=60000

# Job queue
JOB_QUEUE_POLL_MS=1000
JOB_WORKER_ID=""
