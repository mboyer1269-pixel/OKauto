# Auth
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3000"
