# OKauto environment template
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://okauto:okauto@localhost:5432/okauto?schema=public

# Redis (optional in dev — worker falls back to in-process queue)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=OKauto

# AI descriptions (optional — template fallback if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Email (optional — console provider if unset)
SMTP_URL=
EMAIL_FROM=noreply@okauto.local

# Object storage (optional — keep remote photo URLs if unset)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Extension
EXTENSION_API_URL=http://localhost:4000
