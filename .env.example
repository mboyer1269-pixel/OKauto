# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lotpilot

# --- Web / API ---
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Public URL of the web app (used in invite links / emails)
APP_URL=http://localhost:3000

# --- Worker / queue ---
# Optional. When set, jobs run on BullMQ/Redis. When unset, the worker uses an
# in-process interval scheduler (fine for development / single instance).
REDIS_URL=redis://localhost:6379
# How often (minutes) the worker checks for sources due to sync.
SYNC_TICK_MINUTES=1

# --- AI descriptions (optional) ---
# When unset, the deterministic compliant template engine is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Email notifications (optional; logs to stdout when unset) ---
SMTP_URL=
EMAIL_FROM=LotPilot <no-reply@lotpilot.local>

# --- VIN decoding ---
# NHTSA vPIC is a free public API; set to "false" to force the offline decoder.
VIN_DECODER_ONLINE=true
