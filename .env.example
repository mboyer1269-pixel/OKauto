# Database
DATABASE_URL="postgresql://okauto:okauto@127.0.0.1:5432/okauto?schema=public"

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Auth
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETPLACE_CONTACT_NAME="Michael Boyer"
GIT_SHA="dev"

# Public self-serve registration creates a new organization (OWNER).
# Production (Hostinger VPS + Docker Compose + Traefik) MUST keep this false.
# Team members are invited from Dashboard → Équipe.
# Set to true only for local bootstrap or a controlled first-owner setup.
ALLOW_PUBLIC_SIGNUP="false"

# Comma-separated user ids (users.id, signed JWT `sub`) of Suivia platform admins.
# Not dealership OWNER, not emails — emails are unverified and can be spoofed by invite.
# They alone can list, delete, and see « Demandes d’accès ». Empty or unset = nobody.
# Look up by unique login email (read-only). Confirm the dealership (organization
# name/slug) before pasting u.id — never paste an email:
# SELECT u.id, u.email, m."organizationId", o.name AS organization_name, o.slug, m.role
# FROM users u
# LEFT JOIN organization_members m ON m."userId" = u.id
# LEFT JOIN organizations o ON o.id = m."organizationId"
# WHERE lower(u.email) = lower('<courriel>');
PLATFORM_ADMIN_USER_IDS=""

# Trust X-Real-IP / X-Forwarded-For from Traefik. Required on the VPS.
# Defaults to true when NODE_ENV=production. Set false if the app is exposed directly.
# Traefik overwrites X-Real-IP with the connecting client; X-Forwarded-For is read
# from the rightmost hop (see TRUSTED_PROXY_HOPS). Never take the leftmost XFF value.
TRUST_PROXY="true"

# Number of trusted reverse-proxy hops in X-Forwarded-For (default 1 = Traefik).
# With 1 hop, the rightmost XFF entry is the client IP Traefik appended.
TRUSTED_PROXY_HOPS="1"

# OpenAI (optional - template fallback when unset)
OPENAI_API_KEY=""

# Node
NODE_ENV="development"

# AWS S3 (optional — enables photo upload; omit to use URL-only photos)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_URL=""
