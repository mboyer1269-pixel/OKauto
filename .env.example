# ------------------------------------------------------------------
# OpenLot environment template
# Copy to .env (docker compose) or apps/api/.env (local dev) and fill in.
# ------------------------------------------------------------------

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://openlot:openlot@localhost:5432/openlot

# REQUIRED in production: 32+ random chars, e.g. `openssl rand -base64 32`
JWT_SECRET=dev-only-secret-change-me-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated dashboard origins allowed by CORS (extension origins are always allowed)
CORS_ORIGINS=http://localhost:3000
# "auto" = secure cookies only in production; or "true"/"false"
COOKIE_SECURE=auto

# Run background jobs inside the API process (true for single-node/dev,
# false when running the dedicated worker container)
WORKER_INLINE=true
WORKER_POLL_INTERVAL_MS=2000

# Optional: AI descriptions via any OpenAI-compatible endpoint.
# Leave blank to use the built-in deterministic template generator.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Enrich VIN decoding through the public NHTSA vPIC API
ENABLE_NHTSA_DECODER=true

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
