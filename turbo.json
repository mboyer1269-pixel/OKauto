{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "env": ["DATABASE_URL", "JWT_SECRET", "REDIS_URL", "GIT_SHA"]
    },
    "test:unit": {
      "env": ["DATABASE_URL", "JWT_SECRET", "GIT_SHA"]
    },
    "test:int": {
      "env": ["DATABASE_URL", "JWT_SECRET", "REDIS_URL", "GIT_SHA"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "JWT_SECRET"]
    }
  }
}
