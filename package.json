{
  "name": "okauto",
  "private": true,
  "version": "0.1.0",
  "description": "OKauto — dealership Marketplace listing assistant (clean-room)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @okauto/web test:e2e",
    "db:generate": "pnpm --filter @okauto/api prisma:generate",
    "db:migrate": "pnpm --filter @okauto/api prisma:migrate",
    "db:seed": "pnpm --filter @okauto/api prisma:seed",
    "db:reset": "pnpm --filter @okauto/api prisma:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
