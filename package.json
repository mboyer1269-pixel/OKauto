{
  "name": "okauto",
  "version": "0.1.0",
  "private": true,
  "description": "Dealership Facebook Marketplace listing platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @okauto/database generate",
    "db:migrate": "pnpm --filter @okauto/database migrate:dev",
    "db:push": "pnpm --filter @okauto/database push",
    "db:seed": "pnpm --filter @okauto/database seed",
    "db:studio": "pnpm --filter @okauto/database studio",
    "pretest": "pnpm db:generate",
    "start:local": "node scripts/start-local.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "postcss@8": "8.5.6",
      "js-yaml": "4.3.2",
      "nanoid@3": "3.3.18",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@5": "5.0.11"
    }
  }
}
