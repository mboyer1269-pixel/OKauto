# Copy to /opt/okauto/backup.env (chmod 600, root-only).
# Host scripts only — never inject this file into web/worker containers.
# Do not fill this file until a 30-day R2 Bucket Lock is on prefix suivia/.
# R2 has no PutObject-only permission: the VPS token is Object Read & Write
# (includes delete), scoped to this bucket. Protection = Bucket Lock.
# Lifecycle: delete after 30–35 days. Drill token = Object Read only
# in GitHub Environment backup-drill (restricted to main).

# Generate the key pair OFF the VPS:
#   age-keygen -o suivia-backup.age
# Public key (age1...) → BACKUP_AGE_RECIPIENT
# Private key → offline copy + GitHub Environment `backup-drill` secret BACKUP_AGE_IDENTITY
# Leave commented until R2+age are ready (empty assignments would override leftover .env values).
# BACKUP_AGE_RECIPIENT=

# Cloudflare R2 (S3 API). VPS token = Object Read & Write, this bucket only.
# BACKUP_R2_ENDPOINT=
# BACKUP_R2_BUCKET=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_REGION=auto
BACKUP_R2_PREFIX=suivia
# Documents the intended R2 lifecycle (days). Not used to prune from the VPS.
# Invalid or < 7 is rejected and treated as 30.
BACKUP_R2_RETENTION_DAYS=30

# Local dump retention / integrity (host disk)
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_BYTES=10240

# Better Stack / generic heartbeat (GET) after a successful nightly backup.
# Not pinged on deploy --label dumps, and not pinged if offsite fails.
# BACKUP_HEARTBEAT_URL=
