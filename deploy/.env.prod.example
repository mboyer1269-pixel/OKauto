# Copy to /opt/okauto/.env (chmod 600). Never commit real values.

# Immutable image tag (set by deploy.sh)
APP_VERSION=

# Postgres (published on 127.0.0.1:5433)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (published on 127.0.0.1:6379)
REDIS_URL=

# Application
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NEXT_PUBLIC_APP_URL=https://suivia.ca
API_URL=https://suivia.ca
NODE_ENV=production
RUN_MIGRATIONS_ON_BOOT=false

# Optional object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Optional
OPENAI_API_KEY=
NEXT_PUBLIC_MARKETPLACE_CONTACT_NAME=
