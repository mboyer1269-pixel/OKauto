# Copy to /opt/okauto/.env (chmod 600, root-only). Never commit real values.

# Immutable image tag (set by deploy.sh)
APP_VERSION=

# Postgres (published on 127.0.0.1:5433 for host-side admin only)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (published on 127.0.0.1:6379)
REDIS_URL=redis://redis:6379

# Application — use compose DNS names, NOT the loopback publish ports.
# DATABASE_URL=postgresql://USER:PASS@postgres:5432/DB?schema=public
DATABASE_URL=
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NEXT_PUBLIC_APP_URL=https://suivia.ca
API_URL=https://suivia.ca
NODE_ENV=production
RUN_MIGRATIONS_ON_BOOT=false
ALLOW_PUBLIC_SIGNUP=false

# Comma-separated platform-admin emails (not dealership OWNER). Empty = nobody.
# Only these accounts can read/delete access requests (Loi 25 / PII).
PLATFORM_ADMIN_EMAILS=
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1

# GHCR packages stay PRIVATE. Do not put a PAT here.
# As root, once: docker login ghcr.io -u <user> --password-stdin
# (PAT scope read:packages only) → /root/.docker/config.json chmod 600

# Optional object storage (listing photos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Optional
OPENAI_API_KEY=
NEXT_PUBLIC_MARKETPLACE_CONTACT_NAME=

# ---------------------------------------------------------------------------
# Lot 2 — all optional. Leave blank: merge/deploy must not change behaviour.
# Backup / R2 / age keys MUST live in /opt/okauto/backup.env (not here).
# This file is injected into web + worker via compose env_file.
# ---------------------------------------------------------------------------

# Optional Sentry (web + worker). No-op when empty. Release = APP_VERSION.
# Do not send PII (SDK sendDefaultPii=false + beforeSend / beforeBreadcrumb).
SENTRY_DSN=

# Worker uptime heartbeat (Better Stack or any GET URL). No-op when empty.
WORKER_HEARTBEAT_URL=
# Aliases accepted by the worker if WORKER_HEARTBEAT_URL is empty:
# UPTIME_HEARTBEAT_URL=
# BETTERSTACK_HEARTBEAT_URL=

# Sync DÉGRADÉE in-app alert. Off unless explicitly set to 1.
SYNC_DEGRADED_ALERTS=
# Optional webhook (JSON POST) used only when SYNC_DEGRADED_ALERTS=1.
SYNC_ALERT_WEBHOOK_URL=

# Sync HTTP client limits (defaults shown)
SYNC_FETCH_TIMEOUT_MS=30000
SYNC_FETCH_MAX_BYTES=8388608
