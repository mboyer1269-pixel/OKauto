{
  "manifest_version": 3,
  "name": "OKauto ListingOps Assistant",
  "description": "Human-in-the-loop vehicle capture and marketplace listing assistant for dealerships.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OKauto Capture"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
