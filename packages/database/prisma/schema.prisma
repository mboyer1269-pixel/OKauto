generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALESPERSON
}

enum VehicleStatus {
  AVAILABLE
  PENDING
  SOLD
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  REMOVED
  STALE
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum NotificationType {
  SOLD_ALERT
  PRICE_CHANGE
  SYNC_ERROR
  LISTING_REMINDER
  SYSTEM
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  SOLD
  LOST
}

enum LeadSource {
  MARKETPLACE
  PHONE
  WALK_IN
  OTHER
}

enum FeedAbsenceStatus {
  IN_FEED
  PENDING_REVIEW
  KEPT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  IMPORT
  LISTING
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       OrganizationMember[]
  refreshTokens     RefreshToken[]
  assignedVehicles  Vehicle[]            @relation("AssignedTo")
  listings          Listing[]
  marketplaceDrafts MarketplaceDraft[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  importJobs        ImportJob[]
  createdLeads      MarketplaceLead[]  @relation("LeadCreatedBy")
  assignedLeads     MarketplaceLead[]  @relation("LeadAssignedTo")

  @@map("users")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  website              String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  isActive             Boolean  @default(true)
  monthlyListingLimit  Int      @default(5)
  listingRenewalDays   Int      @default(7)
  listingLocale        String   @default("fr")
  freightFee           Decimal  @default(0) @db.Decimal(12, 2)
  pdiFee               Decimal  @default(0) @db.Decimal(12, 2)
  adminFee             Decimal  @default(0) @db.Decimal(12, 2)
  acExciseFee          Decimal  @default(0) @db.Decimal(12, 2)
  marketplaceMonthlyVehicleLimit Int?     @default(5)
  allInPriceConfirmedAt          DateTime?
  allInPriceConfirmedById        String?
  listingLanguage                String    @default("fr")
  listingHighlights              Json?
  metaCatalogFeedEnabled         Boolean   @default(false)
  metaCatalogFeedToken           String?   @unique
  metaCatalogStateForDemo        String    @default("Used")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members           OrganizationMember[]
  vehicles          Vehicle[]
  listings          Listing[]
  marketplaceDrafts MarketplaceDraft[]
  marketplaceLeads  MarketplaceLead[]
  syncSources       SyncSource[]
  importJobs        ImportJob[]
  syncRuns          SyncRun[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  refreshTokens     RefreshToken[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(SALESPERSON)
  marketplaceMonthlyVehicleLimit Int?
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Vehicle {
  id               String        @id @default(cuid())
  organizationId   String
  assignedToId     String?
  syncSourceId     String?
  sourceUrl        String?
  vin              String?
  stockNumber      String?
  year             Int?
  make             String?
  model            String?
  trim             String?
  bodyStyle        String?
  exteriorColor    String?
  interiorColor    String?
  mileage          Int?
  price            Decimal?      @db.Decimal(12, 2)
  msrp             Decimal?      @db.Decimal(12, 2)
  freightFee       Decimal?      @db.Decimal(12, 2)
  pdiFee           Decimal?      @db.Decimal(12, 2)
  adminFee         Decimal?      @db.Decimal(12, 2)
  acExciseFee      Decimal?      @db.Decimal(12, 2)
  description      String?       @db.Text
  descriptionEn    String?       @db.Text
  features         String[]      @default([])
  status           VehicleStatus @default(AVAILABLE)
  fuelType         String?
  transmission     String?
  drivetrain       String?
  engine           String?
  doors            Int?
  cylinders        Int?
  condition        String?       @default("Used")
  location         String?
  notes            String?       @db.Text
  soldAt           DateTime?
  lastSeenAt         DateTime?
  missingSyncCount   Int               @default(0)
  feedAbsenceStatus  FeedAbsenceStatus @default(IN_FEED)
  feedAbsenceNotedAt DateTime?
  managerPriority       Boolean   @default(false)
  managerPriorityNote   String?
  managerPriorityById   String?
  priceDroppedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo        User?              @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  syncSource        SyncSource?        @relation(fields: [syncSourceId], references: [id], onDelete: SetNull)
  photos            VehiclePhoto[]
  listings          Listing[]
  marketplaceDrafts MarketplaceDraft[]
  marketplaceLeads  MarketplaceLead[]

  @@unique([organizationId, vin])
  @@index([organizationId, status])
  @@index([organizationId, stockNumber])
  @@index([organizationId, feedAbsenceStatus])
  @@index([syncSourceId])
  @@map("vehicles")
}

model VehiclePhoto {
  id         String   @id @default(cuid())
  vehicleId  String
  url        String
  storageKey String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_photos")
}

model Listing {
  id                   String        @id @default(cuid())
  organizationId       String
  vehicleId            String
  userId               String
  status               ListingStatus @default(ACTIVE)
  platform             String        @default("facebook_marketplace")
  externalUrl          String?
  externalId           String?
  listedAt             DateTime      @default(now())
  removedAt            DateTime?
  lastCheckedAt        DateTime?
  priceAtListing       Decimal?      @db.Decimal(12, 2)
  titleAtListing       String?
  descriptionAtListing String?       @db.Text
  photoUrlsAtListing   String[]      @default([])
  notes                String?
  lastRenewedAt        DateTime?
  renewalCount         Int           @default(0)
  marketplacePrice     Decimal?      @db.Decimal(12, 2)
  lastPriceConfirmedAt DateTime?
  staleSince           DateTime?
  removalReminderSentAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events           ListingEvent[]
  marketplaceLeads MarketplaceLead[]

  @@index([organizationId, status])
  @@index([userId])
  @@index([vehicleId])
  // Partial unique index (SQL migration): one ACTIVE listing per
  // (organizationId, vehicleId, platform). Prisma cannot express WHERE status='ACTIVE'.
  @@map("listings")
}

model MarketplaceDraft {
  id               String   @id @default(cuid())
  organizationId   String
  vehicleId        String
  userId           String
  platform         String   @default("facebook_marketplace")
  title            String
  description      String   @db.Text
  locale           String   @default("fr")
  titleEn          String?
  descriptionEn    String?  @db.Text
  photoOrder       String[] @default([])
  generationSource String   @default("template")
  dataSnapshot     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, vehicleId, platform])
  @@index([userId, updatedAt])
  @@index([vehicleId])
  @@map("marketplace_drafts")
}

model MarketplaceLead {
  id             String     @id @default(cuid())
  organizationId String
  vehicleId      String?
  listingId      String?
  createdById    String
  assignedToId   String?
  name           String
  phone          String?
  email          String?
  message        String?    @db.Text
  source         LeadSource @default(MARKETPLACE)
  status         LeadStatus @default(NEW)
  nextFollowUpAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([assignedToId])
  @@index([vehicleId])
  @@map("marketplace_leads")
}

model ListingEvent {
  id        String   @id @default(cuid())
  listingId String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_events")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  status         ImportJobStatus @default(PENDING)
  source         String
  fileName       String?
  totalRows      Int             @default(0)
  processedRows  Int             @default(0)
  successCount   Int             @default(0)
  errorCount     Int             @default(0)
  errors         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("import_jobs")
}

model SyncSource {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  url             String
  adapter         String    @default("generic")
  isActive        Boolean   @default(true)
  intervalMinutes Int       @default(60)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  runs         SyncRun[]

  @@index([organizationId])
  @@map("sync_sources")
}

model SyncRun {
  id             String    @id @default(cuid())
  organizationId String
  syncSourceId   String
  status         String    @default("PROCESSING")
  expectedCount  Int?
  receivedCount  Int       @default(0)
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  priceChanges   Int       @default(0)
  soldCount      Int       @default(0)
  durationMs     Int?
  error          String?   @db.Text
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncSource   SyncSource   @relation(fields: [syncSourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([syncSourceId, startedAt])
  @@map("sync_runs")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

model RefreshToken {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  userId         String?
  action         AuditAction
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
