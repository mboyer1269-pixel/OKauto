FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.2 --activate
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat

FROM base AS builder
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY apps/extension/package.json ./apps/extension/
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm --filter @okauto/worker build
# Self-contained production tree (no workspace symlinks in the runner).
RUN pnpm --filter @okauto/worker deploy --prod /out
COPY packages/database/prisma /out/prisma

FROM base AS runner
ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out ./
# Generate Prisma engines for this Alpine/OpenSSL image (same intent as the
# sprint-1 worker image) instead of copying a cross-package .prisma symlink.
RUN ./node_modules/.bin/prisma generate --schema=./prisma/schema.prisma \
  && chown -R node:node /app

USER node
ENV WORKER_HEARTBEAT_PATH=/tmp/worker-heartbeat

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD find /tmp/worker-heartbeat -mmin -2 | grep -q .

CMD ["node", "dist/index.js"]
