{
  "name": "@okauto/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts src/vin-decode-cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:bullmq --external:ioredis --external:@prisma/client --external:@sentry/node",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "lint": "eslint .",
    "vin-decode": "node dist/vin-decode-cli.js"
  },
  "dependencies": {
    "@okauto/database": "workspace:*",
    "@okauto/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^8.55.0",
    "bullmq": "^5.34.3",
    "ioredis": "^5.4.2",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.21.5",
    "tsx": "^4.19.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.6",
    "@vitest/coverage-v8": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
