{
  "manifest_version": 3,
  "name": "OKauto — Marketplace Listing Assistant",
  "version": "0.1.0",
  "description": "Pre-fill the Facebook Marketplace vehicle composer from your OKauto inventory. You review and post — no automated submission.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OKauto"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/marketplace/create/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
