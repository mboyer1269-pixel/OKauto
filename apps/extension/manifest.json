{
  "manifest_version": 3,
  "name": "OKauto Listing Assistant",
  "description": "Human-in-the-loop Marketplace listing assist for dealership inventory. Does not bypass CAPTCHA or platform protections.",
  "version": "0.1.0",
  "action": {
    "default_title": "OKauto",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
