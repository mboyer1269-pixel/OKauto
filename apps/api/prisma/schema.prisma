generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  manager
  salesperson
  viewer
}

enum VehicleType {
  automotive
  rv
  marine
  powersports
  commercial
  other
}

enum VehicleStatus {
  available
  pending
  listed
  sold
  archived
}

enum ListingStatus {
  draft
  prepared
  filled
  submitted
  active
  removed
  sold
  failed
}

enum SourceType {
  csv
  xml
  website
  manual
}

enum SyncStatus {
  pending
  running
  succeeded
  failed
  partial
}

enum NotificationType {
  sold_vehicle
  price_change
  sync_failed
  sync_succeeded
  invite
  system
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dealerships Dealership[]
  memberships Membership[]
  invites     Invite[]
  auditLogs   AuditLog[]
  apiTokens   ApiToken[]
}

model Dealership {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  website        String?
  phone          String?
  timezone       String            @default("America/New_York")
  addressLine1   String?
  city           String?
  state          String?
  postalCode     String?
  country        String            @default("US")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  vehicles       Vehicle[]
  sources        InventorySource[]
  listings       Listing[]
  memberships    Membership[]
  invites        Invite[]

  @@index([organizationId])
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  refreshTokens RefreshToken[]
  apiTokens    ApiToken[]
  listings     Listing[]      @relation("ListingSalesperson")
  listingEvents ListingEvent[]
  notifications Notification[]
  auditLogs    AuditLog[]
  invitesSent  Invite[]       @relation("InviteSender")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealershipId   String?
  dealership     Dealership?  @relation(fields: [dealershipId], references: [id], onDelete: SetNull)
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId, dealershipId])
  @@index([organizationId])
  @@index([userId])
}

model Invite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealershipId   String?
  dealership     Dealership?  @relation(fields: [dealershipId], references: [id], onDelete: SetNull)
  email          String
  role           Role
  tokenHash      String       @unique
  invitedById    String?
  invitedBy      User?        @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ApiToken {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
}

model InventorySource {
  id           String     @id @default(uuid())
  dealershipId String
  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  name         String
  type         SourceType
  config       Json       @default("{}")
  isActive     Boolean    @default(true)
  lastSyncAt   DateTime?
  lastStatus   SyncStatus?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  syncRuns     SyncRun[]
  vehicles     Vehicle[]

  @@index([dealershipId])
}

model SyncRun {
  id        String          @id @default(uuid())
  sourceId  String
  source    InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status    SyncStatus      @default(pending)
  startedAt DateTime        @default(now())
  finishedAt DateTime?
  stats     Json            @default("{}")
  error     String?
  createdAt DateTime        @default(now())

  @@index([sourceId, startedAt])
}

model Vehicle {
  id              String           @id @default(uuid())
  dealershipId    String
  dealership      Dealership       @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          InventorySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  externalId      String?
  vin             String?
  stockNumber     String?
  vehicleType     VehicleType      @default(automotive)
  year            Int?
  make            String?
  model           String?
  trim            String?
  bodyStyle       String?
  exteriorColor   String?
  interiorColor   String?
  mileage         Int?
  price           Decimal?         @db.Decimal(12, 2)
  previousPrice   Decimal?         @db.Decimal(12, 2)
  currency        String           @default("USD")
  description     String?
  aiDescription   String?
  status          VehicleStatus    @default(available)
  attributes      Json             @default("{}")
  lastSeenAt      DateTime?
  soldAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  media           VehicleMedia[]
  listings        Listing[]
  descriptions    DescriptionGeneration[]

  @@unique([dealershipId, vin])
  @@index([dealershipId, status])
  @@index([dealershipId, stockNumber])
  @@index([make, model])
}

model VehicleMedia {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  checksum   String?
  contentType String?
  createdAt  DateTime @default(now())

  @@index([vehicleId, sortOrder])
}

model Listing {
  id                String        @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealershipId      String
  dealership        Dealership    @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  salespersonId     String
  salesperson       User          @relation("ListingSalesperson", fields: [salespersonId], references: [id])
  platform          String        @default("facebook_marketplace")
  status            ListingStatus @default(draft)
  title             String?
  price             Decimal?      @db.Decimal(12, 2)
  description       String?
  externalListingId String?
  externalUrl       String?
  preparedPayload   Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  submittedAt       DateTime?
  removedAt         DateTime?
  events            ListingEvent[]

  @@index([dealershipId, status])
  @@index([salespersonId, createdAt])
  @@index([vehicleId])
}

model ListingEvent {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([type, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String?
  entityId       String?
  meta           Json          @default("{}")
  ip             String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model DescriptionGeneration {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  provider  String
  model     String?
  promptHash String?
  output    String
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}
